{
  "expo": {
    "name": "tsidat",
    "slug": "tsidat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tsidat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of the waste you want to report.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of the waste you want to report.",
        "NSLocationWhenInUseUsageDescription": "Your location helps place the waste report accurately."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Tsidat to take a photo of waste you report.",
          "photosPermission": "Allow Tsidat to choose a photo of waste you report."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tsidat to pin the location of your waste report."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#eff5ef",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
